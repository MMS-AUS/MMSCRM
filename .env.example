# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Custom Domain / Subdomain configuration (optional)
# e.g., https://crm.yourcompany.com.au
VITE_APP_URL=""

# Firebase Client Configuration (optional override for custom domain hosting)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_OAUTH_CLIENT_ID=""

# ==============================================================================
# XERO OAUTH 2.0 INTEGRATION (Production Cloud Accounting)
# ==============================================================================
# XERO_CLIENT_ID: The unique identifier for your registered Xero App (developer.xero.com)
XERO_CLIENT_ID=""

# XERO_CLIENT_SECRET: The confidential secret key generated in Xero Developer Portal
XERO_CLIENT_SECRET=""

# XERO_REDIRECT_URI: Authorized redirect callback URL registered in your Xero App
# Local dev: http://localhost:3000/api/auth/xero/callback
# Production: https://<your-domain>/api/auth/xero/callback
XERO_REDIRECT_URI=""

# NEXT_PUBLIC_APP_URL / APP_URL: Base URL of the application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# SUPABASE CREDENTIAL STORAGE (xero_credentials table)
# ==============================================================================
# SUPABASE_URL: Project URL from your Supabase Dashboard Settings -> API
SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY or SUPABASE_ANON_KEY: API Key for Supabase operations
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""

# ==============================================================================
# GMAIL OAUTH 2.0 & GOOGLE CLOUD PUB/SUB INTEGRATION (Continuous CRM Email Sync)
# ==============================================================================
# GMAIL_CLIENT_ID: OAuth 2.0 Client ID from Google Cloud Console (APIs & Services -> Credentials)
GMAIL_CLIENT_ID=""

# GMAIL_CLIENT_SECRET: OAuth 2.0 Client Secret from Google Cloud Console
GMAIL_CLIENT_SECRET=""

# GMAIL_REDIRECT_URI: Authorized redirect URI configured in Google Cloud Console
# Local dev: http://localhost:3000/api/auth/gmail/callback
# Production: https://<your-domain>/api/auth/gmail/callback
GMAIL_REDIRECT_URI="http://localhost:3000/api/auth/gmail/callback"

# GOOGLE_PUBSUB_TOPIC: Full topic name for Gmail push notifications
# e.g., projects/my-gcp-project-12345/topics/gmail-inbox-watch
GOOGLE_PUBSUB_TOPIC=""

# ==============================================================================
# OPENSOLAR 2-WAY SYNCHRONIZATION & WEBHOOK CONFIGURATION
# ==============================================================================
# OPENSOLAR_ORG_ID: The unique organization ID from OpenSolar
OPENSOLAR_ORG_ID=""

# OPENSOLAR_API_TOKEN: The Bearer token generated from the OpenSolar account (requires opted-in paid plan)
OPENSOLAR_API_TOKEN=""

# NEXT_PUBLIC_APP_URL: Your CRM's base URL for configuring webhooks
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# MAILCHIMP MARKETING & CONTACT SYNCHRONIZATION CONFIGURATION
# ==============================================================================
# MAILCHIMP_API_KEY: Mailchimp API key including datacenter prefix (e.g. 98bf31920acde881290312014-us21)
MAILCHIMP_API_KEY=""

# MAILCHIMP_SERVER_PREFIX: Mailchimp server prefix / datacenter (e.g. us21)
MAILCHIMP_SERVER_PREFIX=""

# MAILCHIMP_AUDIENCE_ID: The unique Mailchimp Audience / List ID (e.g. a7bc92f140)
MAILCHIMP_AUDIENCE_ID=""

# ==============================================================================
# META WHATSAPP BUSINESS CLOUD API INTEGRATION
# ==============================================================================
# WHATSAPP_PHONE_NUMBER_ID: Meta WhatsApp Business Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=""

# WHATSAPP_WABA_ID: WhatsApp Business Account ID (WABA ID)
WHATSAPP_WABA_ID=""

# WHATSAPP_ACCESS_TOKEN: Permanent System User Access Token from Meta Business Manager
WHATSAPP_ACCESS_TOKEN=""

# WHATSAPP_WEBHOOK_VERIFY_TOKEN: Custom secret string used to verify webhook handshakes
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# ==============================================================================
# META GRAPH API & LEAD ADS WEBHOOK SYNC (v25.0)
# ==============================================================================
# META_APP_ID: The unique ID of your Meta App
META_APP_ID=""

# META_APP_SECRET: The confidential secret key
META_APP_SECRET=""

# META_WEBHOOK_VERIFY_TOKEN: Custom secret string used to validate Meta's initial webhook handshake
META_WEBHOOK_VERIFY_TOKEN="solarflow_meta_leadgen_verify_2026"

# ==============================================================================
# META CONVERSIONS API (CAPI) & EVENT MATCH QUALITY (EMQ)
# ==============================================================================
# META_DATASET_ID: The Pixel / Dataset ID from Meta Events Manager
META_DATASET_ID=""

# META_CAPI_ACCESS_TOKEN: The Conversions API System User Access Token
META_CAPI_ACCESS_TOKEN=""

# ==============================================================================
# MICROSOFT TEAMS & GRAPH API OAUTH 2.0 / WORKFLOWS INTEGRATION
# ==============================================================================
# AZURE_CLIENT_ID: The Application (client) ID registered in Microsoft Entra ID (Azure AD)
AZURE_CLIENT_ID=""

# AZURE_CLIENT_SECRET: The client secret value generated in Azure Portal
AZURE_CLIENT_SECRET=""

# AZURE_TENANT_ID: Directory (tenant) ID (use "common" for multi-tenant accounts)
AZURE_TENANT_ID="common"

# TEAMS_WORKFLOW_WEBHOOK_URL: Optional Power Automate Workflows incoming webhook URL
TEAMS_WORKFLOW_WEBHOOK_URL=""

